# Public display name used by app metadata/UI. Safe to expose if referenced by client code.
NEXT_PUBLIC_APP_NAME="Personal Invoicing"

# Canonical app URL. Use http://localhost:3000 locally and your Vercel URL in production.
APP_URL="http://localhost:3000"

# Prisma pooled connection string from Supabase (Project Settings > Database > Connection string > Transaction pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"

# Prisma direct connection string from Supabase for migrations (Project Settings > Database > Connection string > Direct connection).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Supabase project URL. This is browser-safe and must use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anon/public key for browser and server session clients. This is browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase service role key for server-only storage/database admin operations. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Random secret for server-side auth/session flows. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-secret"

# Supabase Storage bucket for uploaded business profile logos. Create a private bucket named business-logos.
SUPABASE_BUSINESS_LOGOS_BUCKET="business-logos"

# Supabase Storage bucket for imported DOCX/PDF template source files. Create a private bucket named templates.
SUPABASE_TEMPLATES_BUCKET="templates"

# Supabase Storage bucket for generated invoice, quotation, and receipt PDFs. Create a private bucket named generated-pdfs.
SUPABASE_GENERATED_PDFS_BUCKET="generated-pdfs"

# Current storage backend. Keep as supabase for Vercel + Supabase deployments.
STORAGE_PROVIDER="supabase"
